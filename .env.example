# Database Configuration
POSTGRES_DB=CircleChat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=CircleChat;Username=postgres;Password=YOUR_POSTGRES_PASSWORD_HERE

# Authentication & Security
JWT_SECRET=YOUR_MINIMUM_32_CHAR_JWT_SECRET_KEY_HERE_1234567890
JWT_ISSUER=CircleChatAPI
JWT_AUDIENCE=CircleChatClients

# Firebase Configuration (Connected project: csharp-dsa-masterclass)
FIREBASE_PROJECT_ID=csharp-dsa-masterclass
FIREBASE_STORAGE_BUCKET=csharp-dsa-masterclass.firebasestorage.app

# Server Base URL (For mobile clients)
SERVER_BASE_URL=http://localhost:5000
